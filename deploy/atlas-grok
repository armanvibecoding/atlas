#!/usr/bin/env bash
# atlas-grok — root'a ait yardımcı. atlas-admin bunu `sudo -n -u atlas` ile çağırır (sudoers yalnız bunu izinler).
# Rol ve ev dizini BURADA zorlanır; sudo ortamı sıfırladığı için çağıran bunları değiştiremez.
# Beyaz liste BURADA da uygulanır: grok kullanıcısı atlas-admin'i atlayıp sudo'yu doğrudan çağırsa bile
# yalnız izinli komutlar çalışır (atlas-admin dize düzeyinde, burası argv düzeyinde; CLI üçüncü katman).
# Ret çıkış kodu: 126.
set -euo pipefail

deny() {
  echo "izin yok: $1" >&2
  logger -t atlas-grok "RED: $1 :: ${ORIG_ARGS:-}" 2>/dev/null || true
  exit 126
}

ORIG_ARGS="$*"
[[ $# -eq 0 ]] && deny "boş komut"
for a in "$@"; do
  [[ "$a" =~ [[:cntrl:]] ]] && deny "kontrol karakteri"
  case "$a" in
    --home|--home=*) deny "--home yasak" ;;
  esac
done

c0="$1"; c1="${2:-}"
case "$c0" in
  status|health|events|budget|note|kill) ;;
  experiments) [[ "$c1" == "summary" ]] || deny "experiments summary" ;;
  verify)      [[ "$c1" =~ ^m[1-5]$ ]] || deny "verify m1..m5" ;;
  report)      [[ "$c1" == "daily" || "$c1" == "weekly" ]] || deny "report daily|weekly" ;;
  strategies)  [[ "$c1" == "list" || "$c1" == "show" ]] || deny "strategies list|show" ;;
  strategy)    [[ "$c1" == "pause" || "$c1" == "demote" || "$c1" == "resume" ]] || deny "strategy pause|demote|resume" ;;
  approvals)   [[ "$c1" == "list" || "$c1" == "show" ]] || deny "approvals list|show" ;;
  *) deny "beyaz listede değil: $c0" ;;
esac

export ATLAS_HOME=/opt/atlas
export ATLAS_ROLE=grok
umask 077
cd /opt/atlas
exec /opt/atlas/bin/atlas "$@"
